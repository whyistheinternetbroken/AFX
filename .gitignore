# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local backups / archives
*.old
*.bak

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime output — keep the folders but ignore their contents
logs/*
!logs/.gitkeep
script_failures/*
ONTAP/*
!ONTAP/.gitkeep
